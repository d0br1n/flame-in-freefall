# Server-side settings of the web app. Copy to .env.local for local work; on Vercel set them in
# the project's environment variables. Never commit real values.

# The data service (apps/api). Read at build time for the /api/v1 forwarding and at run time by
# the assistant's tools.
API_ORIGIN=

# The assistant ("Ask burnrate"). Server only, never sent to the browser. Empty: the assistant
# shows the stored answers only, and live answers need the visitor's own key, entered in the
# panel (it is never stored: see lib/assistant/key.ts).
ANTHROPIC_API_KEY=

# The model: claude-sonnet-5-5 (the default, chosen by the owner), claude-opus-5-5 (dearer) or
# claude-haiku-5-5 (cheaper). Any other value falls back to claude-sonnet-5-5.
ASSISTANT_MODEL=
